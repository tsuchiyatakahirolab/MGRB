{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MGRB ProductBuildSpec v1.1 contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "area"
  ],
  "properties": {
    "area": {
      "type": "string",
      "minLength": 1
    },
    "background": {
      "enum": [
        "clean-publication",
        "bathymetry",
        "bathymetry-relief",
        "minimal-grayscale",
        "navigation-context",
        "satellite-reference",
        "none"
      ]
    },
    "maritime_layers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_kinds": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "input_metadata": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "context_layers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "preview",
          "paper",
          "media",
          "qgis"
        ]
      }
    },
    "custom_extent": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "field_maps": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "include_public_observations": {
      "type": "boolean"
    },
    "visible_footer": {
      "type": "boolean"
    },
    "start_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "end_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
