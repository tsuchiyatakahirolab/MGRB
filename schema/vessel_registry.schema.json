{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mgrb.example/schema/vessel_registry.schema.json",
  "title": "MGRB vessel registry record",
  "type": "object",
  "required": [
    "entity_id", "canonical_name", "aliases", "former_names", "actor_type",
    "identity_confidence", "source_count", "primary_source", "source_refs"
  ],
  "properties": {
    "entity_id": {"type": "string", "minLength": 1},
    "canonical_name": {"type": "string", "minLength": 1},
    "name_cn": {"type": ["string", "null"]},
    "name_en": {"type": ["string", "null"]},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "former_names": {"type": "array", "items": {"type": "string"}},
    "actor_type": {
      "enum": ["PLAN", "CCG", "RESEARCH_SURVEY", "FISHING", "MARITIME_MILITIA", "MSA", "OTHER_GOVERNMENT", "UNKNOWN"]
    },
    "vessel_class": {"type": ["string", "null"]},
    "hull_number": {"type": ["string", "null"]},
    "IMO": {"type": ["string", "null"]},
    "MMSI": {"type": ["string", "null"]},
    "callsign": {"type": ["string", "null"]},
    "operator": {"type": ["string", "null"]},
    "home_port": {"type": ["string", "null"]},
    "length_m": {"type": ["number", "null"]},
    "tonnage": {"type": ["number", "null"]},
    "known_role": {"type": ["string", "null"]},
    "first_seen": {"type": ["string", "null"], "format": "date"},
    "last_seen": {"type": ["string", "null"], "format": "date"},
    "identity_confidence": {"enum": ["DOCUMENTED", "REPORTED", "SUSPECTED", "UNKNOWN"]},
    "source_count": {"type": "integer", "minimum": 1},
    "primary_source": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
