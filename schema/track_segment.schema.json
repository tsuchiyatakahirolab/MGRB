{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mgrb.example/schema/track_segment.schema.json",
  "title": "MGRB maritime track segment",
  "type": "object",
  "required": ["segment_id", "entity_id", "start_time", "end_time", "segment_type", "point_count", "max_gap_seconds", "confidence", "source_set"],
  "properties": {
    "segment_id": {"type": "string"},
    "entity_id": {"type": "string"},
    "actor_type": {"type": "string"},
    "start_time": {"type": "string", "format": "date-time"},
    "end_time": {"type": "string", "format": "date-time"},
    "segment_type": {"enum": ["OBSERVED_TRACK", "SHORT_INTERPOLATION", "INFERRED_CONNECTION"]},
    "point_count": {"type": "integer", "minimum": 2},
    "max_gap_seconds": {"type": "number", "minimum": 0},
    "geometry": {},
    "confidence": {"type": "string"},
    "source_set": {"type": "string"}
  },
  "additionalProperties": true
}
